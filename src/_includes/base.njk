<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{{ title }}</title>
<meta name="description" content="{{ description }}" />
<meta name="author" content="Adrian Cole" />
<meta name="robots" content="{% if noindex %}noindex, follow{% else %}index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1{% endif %}" />
<link rel="canonical" href="{{ site.url }}{{ canonical or page.url }}" />

<!-- Open Graph -->
<meta property="og:type" content="{{ ogType or 'website' }}" />
<meta property="og:site_name" content="Adrian Cole" />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content="{{ ogTitle or title }}" />
<meta property="og:description" content="{{ ogDescription or description }}" />
<meta property="og:url" content="{{ site.url }}{{ canonical or page.url }}" />
<meta property="og:image" content="{{ site.url }}{{ ogImage or '/assets/img/hero-1280.jpg' }}" />
<meta property="og:image:alt" content="{{ ogImageAlt or title }}" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{ ogTitle or title }}" />
<meta name="twitter:description" content="{{ ogDescription or description }}" />
<meta name="twitter:image" content="{{ site.url }}{{ ogImage or '/assets/img/hero-1280.jpg' }}" />
<meta name="twitter:image:alt" content="{{ ogImageAlt or title }}" />
{%- if ogType == 'article' %}
<meta property="article:published_time" content="{{ page.date | isoDate }}" />
<meta property="article:author" content="Adrian Cole" />
{%- endif %}
<meta name="theme-color" content="#131313" />

<link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png" />
<link rel="icon" type="image/png" sizes="256x256" href="/assets/img/favicon-256.png" />
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="alternate" type="application/atom+xml" title="Adrian Cole — Blog" href="/feed.xml" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400;1,500;1,600&family=Spectral:ital,wght@0,400;1,400;1,500&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet" />
{% if preloadImage %}<link rel="preload" as="image" href="{{ preloadImage }}"{% if preloadImageSrcset %} imagesrcset="{{ preloadImageSrcset }}" imagesizes="{{ preloadImageSizes or '100vw' }}"{% endif %} fetchpriority="high" />{% elif heroPreload %}<link rel="preload" as="image" href="/assets/img/hero-1280.jpg" imagesrcset="/assets/img/hero-800.jpg 800w, /assets/img/hero-1280.jpg 1280w, /assets/img/hero-2000.jpg 2000w" imagesizes="100vw" fetchpriority="high" />{% endif %}
<link rel="stylesheet" href="/css/styles.css" />
<noscript><style>[data-reveal]{opacity:1 !important;transform:none !important}</style></noscript>
{% if structuredData %}
<script type="application/ld+json">{{ structuredData | safe }}</script>
{% endif %}
</head>
<body class="preload">

