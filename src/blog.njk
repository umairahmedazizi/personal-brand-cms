---
layout: base.njk
title: "Blog — Adrian Cole"
description: "Essays and reflections on leadership, resilience, and the art of being human by author Adrian Cole."
permalink: /blog/
canonical: /blog
---
<main>
<!-- ===================== PAGE OPENING ===================== -->
<section class="page-hero">
  <div class="container">
    <div class="page-hero__inner" style="max-width:920px">
      <p class="eyebrow" data-reveal>The Journal</p>
      <h1 class="display page-hero__title" data-reveal data-reveal-delay="1">Blog</h1>
      <p class="lead page-hero__intro" data-reveal data-reveal-delay="2">Essays and reflections on leadership, resilience, and the art of being human — written between the books.</p>
    </div>
  </div>
</section>

<!-- ===================== POSTS ===================== -->
<section class="section" style="padding-top:0">
  <div class="container">
    {% if collections.posts and collections.posts.length %}
    <div class="post-grid">
      {% for post in collections.posts %}
      <article class="post-card" data-reveal>
        <p class="post-card__date"><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time></p>
        <h2 class="post-card__title"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
        <p class="post-card__desc">{{ post.data.description }}</p>
        <a href="{{ post.url }}" class="link-arrow">Read more <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      </article>
      {% endfor %}
    </div>
    {% else %}
    <p class="body">New reflections are on the way — check back soon.</p>
    {% endif %}
  </div>
</section>
</main>
