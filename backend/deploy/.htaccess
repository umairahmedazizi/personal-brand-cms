# =====================================================================
#  Adrian Cole — production .htaccess  (Apache / Hostinger)
#
#  Place this file in public_html/.  Expected layout in public_html:
#
#     public_html/
#       index.html  404.html  robots.txt  site.webmanifest
#       about/index.html  contact/index.html  through-the-storm/index.html
#       css/   js/   assets/                 <- the built static site (clean URLs)
#       backend/                             <- the PHP app (this repo's /backend)
#       .htaccess                            <- this file
#
#  It routes the dynamic URLs to PHP and serves everything else as static files.
#  Clean URLs (/about/, /contact/, ...) work natively: Apache serves each folder's
#  index.html via DirectoryIndex, so no extra rewrite rule is required for them.
# =====================================================================

RewriteEngine On

# ---- Canonical host: force HTTPS and the non-www hostname in one 301 ----
#  http://…            -> https://adriancole.example/…
#  http(s)://www.…     -> https://adriancole.example/…
#  Consolidates duplicate-host signals onto a single canonical origin.
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# ---- Legacy .html URLs -> clean URLs (the site moved to extensionless paths) ----
#  Keeps old bookmarks/links working and consolidates SEO onto the new URLs.
#  (404.html is intentionally NOT redirected — it stays the ErrorDocument target.)
RewriteRule ^index\.html$            /                  [R=301,L]
RewriteRule ^about\.html$            /about/            [R=301,L]
RewriteRule ^contact\.html$          /contact/          [R=301,L]
RewriteRule ^through-the-storm\.html$ /through-the-storm/ [R=301,L]
RewriteRule ^blog\.html$             /blog              [R=301,L]
RewriteRule ^books\.html$            /books             [R=301,L]

# ---- Uploaded images live inside the backend folder ----
RewriteRule ^uploads/(.*)$ backend/uploads/$1 [L]

# ---- API ----
RewriteRule ^api/contact/?$     backend/api/contact.php     [L]
RewriteRule ^api/newsletter/?$  backend/api/newsletter.php  [L]
RewriteRule ^api/chat/?$        backend/api/chat.php        [L]

# ---- Admin panel ----
RewriteRule ^admin/?$           backend/admin/index.php     [L]
RewriteRule ^admin/(.+)$        backend/admin/$1            [L]

# ---- Blog ----
RewriteRule ^blog/?$                     backend/blog.php          [L]
RewriteRule ^blog/([A-Za-z0-9-]+)/?$     backend/blog-post.php?slug=$1   [L,QSA]

# ---- Books ----
RewriteRule ^books/?$                    backend/books.php         [L]
RewriteRule ^books/([A-Za-z0-9-]+)/?$    backend/book.php?slug=$1  [L,QSA]

# ---- Sitemap (generated by PHP from the DB so new blog posts auto-appear) ----
RewriteRule ^sitemap\.xml$               backend/sitemap.php       [L]

# Everything else falls through to the static files (index.html, about/index.html, …).

# ---- Custom 404 (your existing static page) ----
ErrorDocument 404 /404.html

# ---- Security: block direct access to sensitive backend internals ----
RewriteRule ^backend/config\.php   - [F]
RewriteRule ^backend/lib/          - [F]
RewriteRule ^backend/data/         - [F]
RewriteRule ^backend/deploy/       - [F]

<FilesMatch "\.(sqlite|sample\.php)$">
  Require all denied
</FilesMatch>

# =====================================================================
#  Security headers (sent on every response). Wrapped in IfModule so the
#  config is a safe no-op on servers where mod_headers is unavailable.
# =====================================================================
<IfModule mod_headers.c>
  # Don't let browsers MIME-sniff a response away from the declared type.
  Header always set X-Content-Type-Options "nosniff"
  # Keep referrer useful for first-party analytics but stripped cross-origin on downgrade.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Clickjacking protection (the site is never meant to be framed by others).
  Header always set X-Frame-Options "SAMEORIGIN"
  # Lock down powerful browser features the site does not use.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
  # Tell browsers to stick to HTTPS for a year. (Ignored over plain HTTP, so safe to send always.)
  Header always set Strict-Transport-Security "max-age=31536000"
  # Cross-origin isolation for the favicon/manifest etc. without blocking outbound links.
  Header always set X-Permitted-Cross-Domain-Policies "none"
</IfModule>

# =====================================================================
#  Compression — shrink text responses on the wire.
# =====================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml application/atom+xml
  AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
  AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2 application/vnd.ms-fontobject
</IfModule>

# =====================================================================
#  Browser caching — long-lived for immutable static assets, revalidate HTML.
#  (CSS/JS use a shorter window because this site updates by re-uploading the
#  same filenames; bump to a year if you adopt cache-busting filenames.)
# =====================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  # Markup: always revalidate so content edits show immediately.
  ExpiresByType text/html "access plus 0 seconds"
  # Stylesheets / scripts: one week.
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
  # Images, fonts, icons: one year (content-stable design assets).
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  # Feeds / manifest: one day.
  ExpiresByType application/atom+xml "access plus 1 day"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>
